# Run local inference on the GPU host and expose an OpenAI-compatible endpoint.
LH_STUDENT_BASE_URL=http://127.0.0.1:8000/v1
LH_STUDENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
LH_STUDENT_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
# Optional for authenticated local inference; never put keys in experiment JSON.
LH_STUDENT_API_KEY=

# Teacher calls are only made by the explicit build-teacher command.
LH_TEACHER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LH_TEACHER_MODEL=
LH_TEACHER_API_KEY=

