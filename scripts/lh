#!/usr/bin/env bash
set -euo pipefail
TASK_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${TASK_ROOT}"
export PYTHONPATH="${TASK_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export ALFWORLD_DATA="${ALFWORLD_DATA:-${TASK_ROOT}/data/alfworld}"
exec "${LH_PYTHON:-${TASK_ROOT}/.venv/bin/python}" -m learning_harness "$@"
