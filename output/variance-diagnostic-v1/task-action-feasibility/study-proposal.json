  "scientific_protocol_document_sha256": "5cdead986f8ed25c332b06bcdd032d44c633a6c65a926edbc3d6b31ccc2f347a",
  "scientific_protocol_text": "# Stage 4\uff1a\u4efb\u52a1\u4e0e\u52a8\u4f5c\u6784\u6210\u5339\u914d\u4e0b\u7684\u7ecf\u9a8c\u9009\u62e9\n\n\u65e5\u671f\uff1a2026-11-13\u3002\u5b8c\u6574Stage 3\u4e0e\u56fa\u5b9a\u68c0\u67e5\u70b9\u590d\u6d4b\u540e\u7684\u540e\u7eed\u7814\u7a76\uff1b\u65b0\u8bad\u7ec3\u524d\u56fa\u5b9a\u65b9\u6848\u3002\u5b83\u6cbf\u7528\u5df2\u591a\u6b21\u68c0\u67e5\u768464\u4e2a\u5f00\u53d1\u4efb\u52a1\uff0c\u56e0\u6b64\u5c5e\u4e8e\u673a\u5236\u63a2\u7d22\uff0c\u4e0d\u4f5c\u4e3a\u672a\u89c1\u6d4b\u8bd5\u96c6\u4e0a\u7684\u786e\u8ba4\u6027\u7ed3\u8bba\u3002\n\n## \u95ee\u9898\u4e0e\u65e2\u6709\u8bc1\u636e\n\nStage 3\u5b8c\u621070\u6a21\u578b/4480\u56de\u5408\uff1b\u4efb\u52a1\u4f4d\u7f6e\u3001\u6b21\u6570\u3001\u4e0d\u540c\u5185\u5bb9\u6570\u548c\u4f18\u5316\u9884\u7b97\u5339\u914d\u540e\uff0c\u4f4eNLL\u2212\u968f\u673a\u6210\u529f\u7387\u4e3aAPI \u221217.7734pp\u3001generic \u22127.8125pp\uff0c\u56db\u521d\u59cb\u5316\u5e73\u5747\u65b9\u5411\u4e00\u81f4\u3002\u539f\u4f4eNLL\u9009\u62e9\u4f1a\u6539\u53d8\u52a8\u4f5c\u6784\u6210\uff1b\u9700\u8981\u68c0\u9a8c\u5339\u914d\u8fd9\u4e00\u56e0\u7d20\u540e\u4ecd\u6709\u591a\u5c11\u5185\u5bb9\u9009\u62e9\u5dee\u5f02\u3002\u539fAPI\u2212ReAct\u5f3a\u57fa\u7ebf\u7684\u8d1f\u5411\u7ed3\u679c\u7ee7\u7eed\u4fdd\u7559\u3002\n\n\u72ec\u7acb\u590d\u6d4b\u4e24\u4e2a\u5df2\u4fdd\u5b58\u68c0\u67e5\u70b9\u5171128\u56de\u5408\uff1b\u9010\u4efb\u52a1\u6210\u8d25\u548c\u6b65\u6570\u5747\u4e0e\u5404\u81ea\u539f\u8bb0\u5f55\u4e00\u81f4\u3002\u76f8\u540c\u79cd\u5b50\u89d2\u8272\u3001\u914d\u7f6e\u548c\u8c03\u5ea6\u7684\u6761\u4ef6\u91cd\u8bad\u4ecd\u6709\u5b9e\u9645\u53c2\u6570\u5dee\u5f02\u3002\u8fd9\u652f\u6301\u589e\u52a0\u521d\u59cb\u5316\u91cd\u590d\uff0c\u800c\u4e0d\u6539\u53d8\u8bad\u7ec3\u7cbe\u5ea6\u3001\u7b97\u6cd5\u6216\u4f18\u5316\u5668\u6765\u6df7\u5165\u65b0\u56e0\u7d20\u3002\n\n## \u63a7\u5236\u4e0e\u5e72\u9884\n\n- \u4e24\u6765\u6e90\uff1a\u65e7API\u4e0egeneric\u6210\u529f\u7ecf\u9a8c\u6c60\uff0c\u4e0d\u65b0\u589e\u6559\u5e08\u8c03\u7528\u3002\n- \u4e24\u7b56\u7565\uff1a\u5728\u76f8\u540c\u4efb\u52a1\u00d7\u52a8\u4f5c\u7c7b\u578b\u5206\u5c42\u5185\u968f\u673a\u9009\u62e9\uff0c\u6216\u9009\u62e9\u57fa\u7840\u5b66\u751f\u4f4e\u76ee\u6807NLL\u5185\u5bb9\u3002\n- 16\u4efd\u771f\u5b9e\u914d\u65b9\uff1a2\u6765\u6e90\u00d72\u7b56\u7565\u00d74\u91c7\u6837\u914d\u65b9\u3002\u9010\u4f4d\u7f6e\u4efb\u52a1ID\u3001\u52a8\u4f5c\u7c7b\u578b\u53ca\u5206\u5c42\u6b21\u6570\u4e00\u81f4\uff1b\u9010\u5c42\u3001\u9010\u4efb\u52a1\u53ca\u5168\u5c40\u4e0d\u540c\u5185\u5bb9\u914d\u989d\u4e00\u81f4\u3002\u6bcf\u6a21\u578b256\u6761\u4e0d\u540c\u4efb\u52a1\u5185\u5bb9\u3001768\u6b21\u5448\u73b0\u3001192\u6b21\u66f4\u65b0\u3002\n- \u914d\u989d\u6cbf\u7528Stage 3\u968f\u673a\u53c2\u8003\uff0c\u4e0d\u8865\u9f50\u53c2\u8003\u4e2d\u4e0d\u5b58\u5728\u7684\u52a8\u4f5c\u7c7b\u522b\u3002\u56e0\u6b64\u7ed3\u8bba\u4ee5\u8be5\u53c2\u8003\u652f\u6301\u4e3a\u6761\u4ef6\u3002\n- \u52a8\u4f5c\u5339\u914d\u540e\u4e24\u7b56\u7565\u7684\u4e0d\u540c\u652f\u6301\u7ea6\u4e3aAPI 25.59%\u3001generic 37.30%\uff1bNLL\u9009\u62e9\u5dee\u5f02\u4fdd\u7559\u539f\u4efb\u52a1\u5339\u914d\u7684\u7ea666.15%\u4e0e40.44%\u3002\u5e72\u9884\u5f3a\u5ea6\u4e5f\u53d8\u5f31\uff0c\u4e0d\u80fd\u628a\u6548\u679c\u8870\u51cf\u76f4\u63a5\u5f53\u6210\u52a8\u4f5c\u6784\u6210\u7684\u56e0\u679c\u4e2d\u4ecb\u6bd4\u4f8b\u3002\n- Qwen3-4B-Instruct-2507\u6a21\u578brevision\u3001LoRA\u3001\u4f18\u5316\u5668\u3001\u8bad\u7ec3\u9884\u7b97\u3001\u5171\u540cJSON\u6267\u884c\u5185\u6838\u53caA+\u96f6B\u7ec4\u6210\u5168\u90e8\u7ee7\u627f\u7236\u7814\u7a76\uff0c\u5b9e\u9645token\u6d88\u8017\u53e6\u5916\u62a5\u544a\uff1b\u6b21\u6570\u5339\u914d\u4e0d\u58f0\u79f0\u7cbe\u786eFLOP\u5339\u914d\u3002\n\n## \u91cd\u590d\u3001\u9884\u7b97\u4e0e\u56fa\u5b9a\u961f\u5217\n\n\u521d\u59cb\u5316101/202/303/404/505/606\uff0c\u91c7\u6837\u914d\u65b9101/202/303/404\uff0c\u4e24\u6765\u6e90\u00d7\u4e24\u7b56\u7565\uff0c\u517196\u4e2a\u4e3b\u8981\u6a21\u578b\uff1b\u53e6\u5728\u521d\u59cb\u5316101/\u91c7\u6837101\u5bf9\u4e24\u6765\u6e90\u548c\u4e24\u7b56\u7565\u5404\u91cd\u8bad\u4e00\u6b21\uff0c\u51714\u4e2a\u6761\u4ef6\u91cd\u590d\u3002\u603b100\u6a21\u578b\u30016400\u65b0\u8bc4\u6d4b\u56de\u5408\u3002\n\n\u516d\u521d\u59cb\u5316\u7684\u9009\u62e9\u53d1\u751f\u5728Stage 4\u4ea7\u751f\u4efb\u4f55\u7ed3\u679c\u4e4b\u524d\uff0c\u76ee\u7684\u662f\u66f4\u5b8c\u6574\u5448\u73b0\u5df2\u89c2\u5bdf\u7684\u8bad\u7ec3\u53d8\u5f02\uff0c\u4e0d\u58f0\u79f0\u6ee1\u8db3\u67d0\u4e2a\u9884\u8bbe\u663e\u8457\u6027\u68c0\u9a8c\u529b\u3002\u539f\u56db\u521d\u59cb\u5316\u8349\u6848\u53e6\u5b58\uff0c\u6a21\u578b\u9884\u7b97\u53ca\u5df2\u6709\u56db\u521d\u59cb\u5316GPU\u5206\u914d\u4e0d\u53d8\uff1b\u65b0\u589e\u4e24\u4e2a\u521d\u59cb\u5316\u4f9d\u539f\u89c4\u5219\u4ea4\u66ffGPU\u53ca\u7b56\u7565\u5148\u540e\u987a\u5e8f\u3002\u540c\u4e00\u6765\u6e90/\u521d\u59cb\u5316/\u91c7\u6837\u914d\u65b9\u7684\u7b56\u7565\u5bf9\u4f7f\u7528\u540c\u4e00\u7269\u7406GPU\u3002\n\n\u4e24\u5f205090\u5e76\u884c\uff0c\u4e0a\u965018\u7d2f\u8ba1GPU\u5c0f\u65f6\uff1b\u6bcf\u6a21\u578b\u6700\u591a\u9884\u75591800\u79d2\uff0c\u5269\u4f59\u672a\u9884\u7559\u9884\u7b97\u5c11\u4e8e900\u79d2\u4e0d\u542f\u52a8\u4e0b\u4e00\u6a21\u578b\u3002\u5931\u8d25\u3001\u8d85\u65f6\u548c\u4e2d\u65ad\u65f6\u95f4\u5747\u8ba1\u5165\u3002\u5b8c\u6574\u7236\u5b9e\u9a8c\u5e73\u5747\u7ea6531\u79d2/\u6a21\u578b\uff0c\u7ebf\u6027\u4f30\u8ba1\u672c\u8f6e\u7ea614.8\u7d2f\u8ba1GPU\u5c0f\u65f6\uff1b\u8fd9\u662f\u9884\u7b97\u4f30\u8ba1\uff0c\u4e0d\u662f\u5899\u949f\u627f\u8bfa\u3002\n\n\u542f\u52a8\u524d\u68c0\u67e5\u4e24GPU\u3001\u65e2\u6709\u6a21\u578b\u670d\u52a1\u7aef\u53e3\u3001\u5b58\u50a8\u5bb9\u91cf\u548c\u660e\u786e\u8bb0\u5f55\u7684\u7a7a\u95f2\u540e\u53f0\u4e0a\u4e0b\u6587\uff1b\u4e0d\u505c\u6b62\u5176\u4ed6\u5e94\u7528\u3002\u9884\u7559\u9879\u7ed1\u5b9aworker PID\u3001GPU\u3001\u65f6\u9650\u4e0e\u51bb\u7ed3\u54c8\u5e0c\u3002\u4fdd\u6301localhost\u4e0d\u7ecf\u8fc7\u4ee3\u7406\u3002\n\n## \u7ec8\u70b9\u4e0e\u89e3\u91ca\n\n\u4e3b\u8981\u7ec8\u70b9\u4e3a\u6bcf\u6a21\u578b\u65e0\u8f85\u52a9\u6210\u529f\u7387\uff1a\u51b7\u5374/\u52a0\u70ed\u540432\u4e2a\u56fa\u5b9a\u5f00\u53d1\u4efb\u52a1\uff0c\u4e24\u4e2a\u4efb\u52a1\u65cf\u7b49\u6743\uff1b\u73af\u5883\u79cd\u5b5011\u3001\u6e29\u5ea60\u3001batch 8\u3002\u4e3b\u8981\u5bf9\u6bd4\u662f\u5728\u6bcf\u6765\u6e90\u5185\u8ba1\u7b97\u4f4eNLL\u2212\u968f\u673a\uff0c\u5148\u572824\u4e2a\u521d\u59cb\u5316\u00d7\u91c7\u6837\u914d\u5bf9\u5355\u5143\u7b49\u6743\u5e73\u5747\uff0c\u518d\u9010\u521d\u59cb\u5316\u62a5\u544a\u56db\u4e2a\u91c7\u6837\u914d\u65b9\u5e73\u5747\u3002\u4e24\u4e2a\u6765\u6e90\u5206\u5217\uff0c\u4e0d\u5f53\u4f5c\u72ec\u7acb\u73af\u5883\u3002\n\n\u6240\u6709\u6210\u5bf9\u5355\u5143\u3001\u516d\u521d\u59cb\u5316\u503c\u3001\u80dc/\u5e73/\u8d1f\u3001\u4efb\u52a1\u65cf\u5206\u89e3\u548c\u539f\u59cb\u6210\u529f/\u5931\u8d25\u4fdd\u7559\u3002\u6761\u4ef6\u8bad\u7ec3\u91cd\u590d\u4e0d\u8fdb\u5165\u4e3b\u5747\u503c\uff0c\u53e6\u62a5\u5dee\u503c\u3002\u8bca\u65adNLL\u3001\u5b9e\u9645token\u53ca\u52a8\u4f5c/\u5185\u5bb9\u914d\u989d\u6838\u5bf9\u4e3a\u8f85\u52a9\u7ed3\u679c\u3002\u4e0d\u7ed9\u51fa\u672a\u7ecf\u6821\u51c6\u7684\u5c11\u79cd\u5b50bootstrap\u533a\u95f4\u6216\u663e\u8457\u6027\u7ed3\u8bba\u3002\n\n\u82e5\u5339\u914d\u52a8\u4f5c\u540e\u5dee\u5f02\u4ecd\u5b58\u5728\uff0c\u652f\u6301\u5269\u4f59\u5185\u5bb9\u9009\u62e9\u6548\u5e94\uff1b\u82e5\u5dee\u5f02\u7f29\u5c0f\u6216\u6d88\u5931\uff0c\u7ed3\u679c\u7ea6\u675f\u7ecf\u9a8c\u4ef7\u503c\u4ee3\u7406\u7684\u9002\u7528\u6761\u4ef6\uff0c\u540c\u65f6\u5fc5\u987b\u62a5\u544a\u9009\u62e9\u5f3a\u5ea6\u53d8\u5316\u548c\u8bad\u7ec3\u6ce2\u52a8\u3002\u65e0\u8bba\u65b9\u5411\u5982\u4f55\u90fd\u5b8c\u6210\u65e2\u5b9a\u961f\u5217\u3001\u4fdd\u7559\u5f3a\u57fa\u7ebf\uff0c\u4e0d\u80fd\u4ee5\u4e0d\u663e\u8457\u58f0\u79f0\u7b49\u6548\u6216\u8bc1\u660e\u52a8\u4f5c\u6784\u6210\u662f\u552f\u4e00\u673a\u5236\u3002\n\n## \u89c2\u5bdf\u4e0e\u4ea4\u4ed8\n\n1/4/8/12/16/20/24\u4e2a\u4e24\u6765\u6e90\u4e24\u7b56\u7565\u5747\u5b8c\u6574\u7684\u914d\u5bf9\u5355\u5143\u751f\u6210\u63cf\u8ff0\u6027\u4e2d\u9014\u56fe\uff1b\u56fe\u56fa\u5b9a\u4e8e\u9996\u6b21\u89c2\u5bdf\u5230\u8282\u70b9\u7684\u5b8c\u6210\u72b6\u6001\u3002\u6ca1\u6709\u6309\u6548\u679c\u63d0\u524d\u505c\u6b62\u3001\u6362\u79cd\u5b50\u6216\u6539\u961f\u5217\u3002\u534a\u5c0f\u65f6\u76d1\u7763\u5668\u7ee7\u7eed\u6838\u9a8c\u5b9e\u9645\u8fdb\u7a0b\uff0c\u7ec8\u6001\u53ca\u65f6\u8bb0\u5f55\uff1b\u4e0d\u4f1a\u81ea\u52a8\u91cd\u542fGPU\u3002\n\nW&B\u4ec5\u63a8\u9001\u6c47\u603bJSON\u3001PNG/PDF\u548c\u7ed3\u679c\u8bf4\u660e\uff1b\u4efb\u52a1ID\u3001\u9010\u4efb\u52a1\u8f68\u8ff9\u4e0e\u66b4\u9732CSV\u4fdd\u7559\u672c\u5730\u3002GitHub\u4fdd\u5b58\u534f\u8bae\u3001\u4ee3\u7801\u548c\u5b89\u5168\u6c47\u603b\uff1b\u5927\u6743\u91cd\u5b8c\u6210\u540e\u8fc1\u5165\u6307\u5b9aWorkSpace\u786c\u76d8\u5e76\u6821\u9a8c\u54c8\u5e0c\uff0c\u539f\u8def\u5f84\u4fdd\u7559\u3002\n\n\u5b8c\u6574\u7ed3\u679c\u540e\u518d\u51b3\u5b9a\u7b2c\u4e8c\u73af\u5883\u534f\u8bae\u548c\u6b63\u5f0f\u7559\u51fa\u8bc4\u6d4b\u3002\u5f53\u524d\u7814\u7a76\u4e0d\u6253\u5f00ALFWorld\u6b63\u5f0fseen/unseen\u96c6\u5408\uff0c\u4e5f\u4e0d\u628aWebShop\u76841000\u5546\u54c1\u5f00\u53d1\u9884\u89c8\u5f53\u4f5c\u6b63\u5f0fbenchmark\u3002\n"
}
